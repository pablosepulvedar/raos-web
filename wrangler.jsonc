{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "raos-web",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "raos-web" }],
  // Un solo worker para todas las empresas: el subdominio no cambia el código, la
  // empresa sale de la sesión (mi_empresa_id). Una empresa nueva queda viva con solo
  // crear su fila en `empresas`, sin deploy.
  //   raos.reservaps.cl, demo.reservaps.cl, admin.reservaps.cl, <nueva>.reservaps.cl
  // La raíz y www NO entran acá: las sirve el worker reservaps-landing.
  "routes": [
    { "pattern": "*.reservaps.cl/*", "zone_name": "reservaps.cl" }
  ]
}
